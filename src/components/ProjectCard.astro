---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  year: number;
}
const { slug, title, summary, tags, year } = Astro.props;
---
<div class="card project-card reveal">
  <div class="body">
    <span class="eyebrow">{year}</span>
    <h2><a href={`/projects/${slug}`}>{title}</a></h2>
    <p>{summary}</p>
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <a class="know-more" href={`/projects/${slug}`}>Know more →</a>
  </div>
</div>
