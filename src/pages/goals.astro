---
import Base from '../layouts/Base.astro';

// Provisional icons — swap these inline SVGs for real ones later.
// Each is a simple 24x24 line icon so they stay consistent in weight.
const icons = {
  understand: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/></svg>`,
  design: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 15h16"/></svg>`,
  share: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/></svg>`,
  evaluate: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 19V9M12 19V5M20 19v-6"/></svg>`,
  collaborate: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="9" cy="9" r="3"/><circle cx="17" cy="14" r="3"/><path d="M6 20c0-2.2 1.5-4 3-4M14 20c0-1.8 1.3-3.2 3-3.2"/></svg>`,
  teach: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 6l8-3 8 3-8 3-8-3z"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg>`,
};

const goals = [
  { text: 'Promote research on interaction design, information visualization, and mediated communication.', icon: icons.understand },
  { text: "Generate knowledge and outcomes about mediated interactions and complex visual communication through analytical, descriptive and practice-based methods.", icon: icons.design },
  { text: 'Foster design and interaction as research areas critically concerned with social and emerging issues and that can speculate and engage in developing alternative futures.', icon: icons.share },
  { text: 'Contribute to the advancement of these areas in academia, relating to design degrees, but also involving and supporting new communities of practice.', icon: icons.evaluate },
  { text: 'Expand the understanding of design and interaction, in its foundations, processes, intersections, materializations and consequences.', icon: icons.collaborate },
  { text: 'Include and support network projects through cooperation with scientific researchers and institutions.', icon: icons.teach },
];
---
<Base title="Goals">
  <section style="padding-top:64px;">
    <div class="container">
      <span class="eyebrow">Goals</span>

      <div class="grid grid-2" style="margin-top:32px; column-gap:56px;">
        {goals.map((g) => (
          <div class="reveal">
            <div class="goal-icon" set:html={g.icon} />
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
